PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Where contact form emails are delivered
CONTACT_EMAIL=hello@madar.digital
CONTACT_TO_EMAIL=hello@madar.digital

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Until your domain is verified in Resend, use:
# CONTACT_FROM_EMAIL=MADAR <onboarding@resend.dev>
# After verifying madar.digital / madar-il.com, switch to e.g.:
# CONTACT_FROM_EMAIL=MADAR <hello@madar.digital>
CONTACT_FROM_EMAIL=MADAR <onboarding@resend.dev>

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
